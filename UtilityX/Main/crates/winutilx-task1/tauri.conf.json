{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ollumi",
  "version": "0.1.1",
  "mainBinaryName": "Ollumi_0.1.1",
  "identifier": "com.winutilx.desktop",
  "build": {
    "frontendDist": "../../spikes/spike-tauri-baseline/dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
                    "installMode": "currentUser",
                    "installerHooks": "../../windows/nsis-hooks.nsh"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Ollumi",
        "label": "main",
        "url": "index.html",
        "width": 880,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": true
      }
    ]
  }
}


